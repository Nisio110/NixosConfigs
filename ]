{
  environment.systemPackages = [pkgs.openssl];
  systemd.tmpfiles.rules = [
    "d /var/lib/ssl/ 0700 root root -"
    "d /var/lib/tetocorp/ 0755 oisin oisin -"
  ];

  security.pki.certificateFiles = [/var/lib/tetocorp/tetocorp.crt]
  
  systemd.services."tetocorp-ssl" = {
      after =     [ "NetworkManager.service" ];
      partOf =    [ "teto.slice" ];
      wantedBy =  [ "teto.slice" ];
      path = [ pkgs.openssl ];

      serviceConfig = {
        Slice               = "teto-infra.slice";
        Restart             = lib.mkOverride 90 "always";
        RestartMaxDelaySec  = lib.mkOverride 90 "1h";
        RestartSec          = lib.mkOverride 90 "100ms";
        RestartSteps        = lib.mkOverride 90 9;
      };
      script = ''
        # Private key
        openssl genrsa \
          -out /var/lib/ssl/tetocorp.key 4096

        # CSR file
        # Provides info embedded into the key
        openssl req -new \
          -key /var/lib/ssl/tetocorp.key \
          -out /var/lib/ssl/tetocorp.csr \
          \
          -subj \
        "/C=IE"\
        "/ST=Dublin"\
        "/O=tetocorp"\
        "/CN=tetocorp.ie"\
          \
          -addext "subjectAltName="\
        "DNS:tetocorp.ie,"\
        "DNS:watch.tetocorp.ie,"\
        "DNS:vpn.tetocorp.ie,"\
        "DNS:notes.tetocorp.ie,"\
        "DNS:manga.tetocorp.ie,"\
        "DNS:cloudflare-bypass.tetocorp.ie,"\
        "DNS:print.tetocorp.ie,"\
        "DNS:stream.tetocorp.ie"

        # SSL Cert
        # -req    : treat input as csr instead of a crt
        # -days 3 : valid for n days
        openssl x509 \
          -req \
          -days 3 \
          -in /var/lib/ssl/tetocorp.csr \
          -signkey /var/lib/ssl/tetocorp.key \
          -out /var/lib/tetocorp/tetocorp.crt
      ''
    };
}
